# === REQUIRED ===
DB_PASSWORD=change_me
JWT_SECRET_KEY=change_me

# === OPTIONAL (defaults shown) ===
DB_USER=store
DB_NAME=store

JWT_HTTP_ONLY=true

CORS_ALLOWED_CREDENTIALS=true
CORS_ALLOWED_ORIGINS=*

# === INTEGRATION: plug your images here ===
# Override if you're not using humbertosandmann/* defaults
PRODUCT_IMAGE=humbertosandmann/product:latest
EXCHANGE_IMAGE=humbertosandmann/exchange:latest

# Override if your services run on a different host/port
PRODUCT_API_URL=http://product:8080
EXCHANGE_API_URL=http://exchange:8080
